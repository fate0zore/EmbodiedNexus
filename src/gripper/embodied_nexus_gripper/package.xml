<?xml version="1.0"?>
<package format="3">
  <name>embodied_nexus_gripper</name>
  <version>0.1.0</version>
  <description>Configurable ROS 2 MS42DC gripper adapter and HTTP gateway.</description>
  <maintainer email="maintainer@example.com">EmbodiedNexus</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>embodied_nexus_gripper_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-starlette</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
