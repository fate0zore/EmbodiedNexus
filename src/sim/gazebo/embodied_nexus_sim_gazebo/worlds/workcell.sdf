<?xml version="1.0"?>
<sdf version="1.9">
  <world name="embodied_nexus_workcell">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <!-- Fortress OGRE2 currently crashes in WSLg sensor rendering on some
           hosts; OGRE 1 keeps GPU camera / lidar sensors working there. -->
      <render_engine>ogre</render_engine>
    </plugin>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.78 0.84 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_box">
      <static>true</static>
      <pose>2.6 1.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 0.8 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.35 0.8 2.0</size></box></geometry><material><ambient>0.8 0.15 0.08 1</ambient><diffuse>0.8 0.15 0.08 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
