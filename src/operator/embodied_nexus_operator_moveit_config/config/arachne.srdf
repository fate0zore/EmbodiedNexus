<?xml version="1.0"?>
<robot name="arachne">
  <group name="manipulator">
    <chain base_link="aubo_base_link" tip_link="grasp_frame"/>
  </group>
  <group_state name="observe" group="manipulator">
    <joint name="aubo_shoulder_joint" value="0.0"/>
    <joint name="aubo_upperArm_joint" value="-1.20"/>
    <joint name="aubo_foreArm_joint" value="1.70"/>
    <joint name="aubo_wrist1_joint" value="-2.10"/>
    <joint name="aubo_wrist2_joint" value="-1.5708"/>
    <joint name="aubo_wrist3_joint" value="0.0"/>
  </group_state>
  <disable_collisions link1="base_link" link2="aubo_base_link" reason="Adjacent"/>
  <disable_collisions link1="aubo_base_link" link2="aubo_shoulder_Link" reason="Adjacent"/>
  <disable_collisions link1="aubo_shoulder_Link" link2="aubo_upperArm_Link" reason="Adjacent"/>
  <disable_collisions link1="aubo_upperArm_Link" link2="aubo_foreArm_Link" reason="Adjacent"/>
  <disable_collisions link1="aubo_foreArm_Link" link2="aubo_wrist1_Link" reason="Adjacent"/>
  <disable_collisions link1="aubo_wrist1_Link" link2="aubo_wrist2_Link" reason="Adjacent"/>
  <disable_collisions link1="aubo_wrist2_Link" link2="aubo_wrist3_Link" reason="Adjacent"/>
  <disable_collisions link1="aubo_wrist3_Link" link2="ee_camera_support_link" reason="Adjacent"/>
  <disable_collisions link1="ee_camera_support_link" link2="ee_camera_link" reason="Adjacent"/>
  <disable_collisions link1="ee_camera_support_link" link2="ms42dc_base_link" reason="Adjacent"/>
  <disable_collisions link1="ms42dc_base_link" link2="ms42dc_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="ms42dc_base_link" link2="ms42dc_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="ms42dc_base_link" link2="ms42dc_mid_link" reason="Adjacent"/>
  <disable_collisions link1="ms42dc_mid_link" link2="ms42dc_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="ms42dc_mid_link" link2="ms42dc_right_finger_link" reason="Adjacent"/>
</robot>
